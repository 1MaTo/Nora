{
  "name": "nora",
  "version": "2.0.0",
  "type": "module",
  "imports": {
    "#discord/*": "./src/utils/discord/*",
    "#env": "./src/utils/shared/env.ts",
    "#shared/*": "./src/utils/shared/*"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.secret src/index.ts",
    "upload-commands-dev": "node --env-file=.env.secret src/upload-commands-dev.ts",
    "prepare": "husky",
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "pkgroll"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "google-translate-api-x": "^10.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "pkgroll": "^2.27.0",
    "tsx": "^4.21.0"
  },
  "lint-staged": {
    "*": [
      "pnpm format --no-error-on-unmatched-pattern",
      "pnpm lint --deny-warnings"
    ]
  }
}
