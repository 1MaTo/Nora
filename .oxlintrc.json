{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {},
  "rules": {
    "import/no-cycle": ["error", { "maxDepth": 3 }]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**"]
}
